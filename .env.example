VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Supabase Edge Function secrets (configure with `supabase secrets set`).
APP_ORIGIN=https://core.memudecore.com.br
WEBHOOK_SECRET=generate-a-random-secret
INTERNAL_FUNCTION_SECRET=generate-a-different-random-secret
CRON_SECRET=generate-a-third-random-secret

# Optional: synthetic staging account for the authenticated Playwright suite.
E2E_ADMIN_EMAIL=admin-e2e@example.test
E2E_ADMIN_PASSWORD=use-a-secret-manager
E2E_CORRETOR_EMAIL=corretor-e2e@example.test
E2E_CORRETOR_PASSWORD=use-a-secret-manager
E2E_CLIENTE_EMAIL=cliente-e2e@example.test
E2E_CLIENTE_PASSWORD=use-a-secret-manager
